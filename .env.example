# Copy to .env and fill in. Never commit .env or paste the token anywhere public.
TELEGRAM_BOT_TOKEN=
# Channel the raw signals appear in (bot must be admin). Numeric id (-100...) or @username.
SOURCE_CHAT_ID=
# Private group that receives the styled cards (bot must be admin). Numeric id (-100...).
TARGET_CHAT_ID=
# If the group uses Topics: the topic number from its link t.me/c/<group>/<topic>
TARGET_THREAD_ID=

# Branding on the card
BRAND_NAME=SIGNAL DESK
BRAND_HANDLE=t.me/yourchannel
BRAND_DISCLAIMER=Not financial advice · risk only what you can afford to lose

# Only for webhook mode (TradingView -> this bot directly)
WEBHOOK_SECRET=

# Where state and rendered images live (point at a persistent volume on hosts)
STATE_FILE=signals.json
OUT_DIR=out

# Weekly results recap (posted to TARGET_CHAT_ID). RECAP_ENABLED=0 turns it off.
RECAP_ENABLED=1
RECAP_DAY=sat
RECAP_TIME=12:00
RECAP_TZ=Asia/Almaty
# How a stop-loss after a TP counts: breakeven | best_tp | loss
RECAP_SL_AFTER_TP=breakeven

# Daily "signal of the day" to a second channel (Russian card + caption).
# Posts today's latest still-open AFX signal once, between DAILY_TIME and DAILY_LATEST.
DAILY_ENABLED=0
DAILY_CHAT_ID=@arutnews
# Bot that is admin in DAILY_CHAT_ID (defaults to TELEGRAM_BOT_TOKEN)
DAILY_BOT_TOKEN=
DAILY_TIME=19:20
DAILY_LATEST=19:50
DAILY_TZ=Asia/Almaty
# First day to post, YYYY-MM-DD (empty = from today)
DAILY_START=
DAILY_CTA=Вступай в бесплатное коммьюнити тут https://linktw.in/skauch
DAILY_HANDLE=linktw.in/skauch

# Health check for outside monitoring (Railway sets PORT automatically)
# HEALTH_PORT=8080
